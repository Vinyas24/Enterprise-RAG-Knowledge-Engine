# Copy to `.env` for local (non-Docker) runs:  cp .env.example .env
# Docker Compose reads `.env` automatically for variable interpolation.
# The values below are development defaults and are NOT secrets.

# --- application ----------------------------------------------------------
RAG_APP_NAME=rag-engine
# local | test | staging | production
RAG_ENVIRONMENT=local
RAG_DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
RAG_LOG_LEVEL=INFO
# json (machine-readable, production default) | console (human-readable)
RAG_LOG_FORMAT=console

# --- database -------------------------------------------------------------
# Must use the asyncpg driver: postgresql+asyncpg://user:pass@host:port/db
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag_dev_password@localhost:5432/rag
RAG_DATABASE_POOL_SIZE=5
RAG_DATABASE_POOL_TIMEOUT_SECONDS=10
RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=5
RAG_DATABASE_ECHO=false

# --- health checks --------------------------------------------------------
RAG_HEALTH_CHECK_TIMEOUT_SECONDS=2

# --- ingestion ------------------------------------------------------------
# Where uploaded bytes are stored when running outside Docker.
RAG_BLOB_STORE_PATH=data/uploads
# 25 MiB. Requests above this are rejected while streaming, not after buffering.
RAG_UPLOAD_MAX_BYTES=26214400
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
# Only "recursive" today; the factory makes additional strategies pluggable.
RAG_CHUNK_STRATEGY=recursive

# --- ingestion worker -----------------------------------------------------
RAG_WORKER_POLL_INTERVAL_SECONDS=0.5
RAG_WORKER_MAX_ATTEMPTS=3
RAG_WORKER_RETRY_BASE_SECONDS=2
RAG_WORKER_RETRY_MAX_SECONDS=60
RAG_WORKER_VISIBILITY_TIMEOUT_SECONDS=300

# --- embedding ------------------------------------------------------------
# "deterministic" (default, no API key needed) | "openai"
RAG_EMBEDDING_PROVIDER=deterministic
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=256
# Required when RAG_EMBEDDING_PROVIDER=openai:
# RAG_EMBEDDING_API_KEY=sk-...
RAG_EMBEDDING_API_BASE=https://api.openai.com/v1
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_MAX_RETRIES=4
RAG_EMBEDDING_RETRY_BASE_SECONDS=0.5
RAG_EMBEDDING_RETRY_MAX_SECONDS=20

# --- vector store ---------------------------------------------------------
# "memory" (default, no network needed) | "pinecone"
RAG_VECTOR_STORE=memory
# Required when RAG_VECTOR_STORE=pinecone:
# RAG_PINECONE_API_KEY=pcsk_...
RAG_PINECONE_INDEX_NAME=rag-engine
RAG_PINECONE_METRIC=cosine
RAG_PINECONE_CLOUD=aws
RAG_PINECONE_REGION=us-east-1
# Override for Pinecone Local (e.g. http://localhost:5081):
# RAG_PINECONE_CONTROL_HOST=
# RAG_PINECONE_INDEX_HOST=
RAG_PINECONE_TIMEOUT_SECONDS=30
RAG_VECTOR_UPSERT_BATCH_SIZE=100
RAG_VECTOR_DELETE_BATCH_SIZE=1000
RAG_VECTOR_LIST_PAGE_SIZE=100

# --- retrieval ------------------------------------------------------------
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_MIN_SCORE=0.0
# "dense" (Phase 4 behaviour) | "hybrid" (dense + BM25 keyword, fused)
RAG_RETRIEVAL_MODE=hybrid
# Reciprocal rank fusion weights. Setting one to 0 removes that path.
RAG_HYBRID_DENSE_WEIGHT=1.0
RAG_HYBRID_KEYWORD_WEIGHT=1.0
RAG_HYBRID_RRF_K=60
# How many PostgreSQL full-text candidates BM25 re-ranks per query.
RAG_RETRIEVAL_KEYWORD_CANDIDATES=200

# --- generation / LLM -----------------------------------------------------
# "deterministic" (default, no API key needed) | "openai"
RAG_LLM_PROVIDER=deterministic
RAG_LLM_MODEL=gpt-4o-mini
# Required when RAG_LLM_PROVIDER=openai:
# RAG_LLM_API_KEY=sk-...
RAG_LLM_API_BASE=https://api.openai.com/v1
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_MAX_TOKENS=1024

# --- postgres container (docker compose only) -----------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag
POSTGRES_PORT=5432
# Host port for the API container.
API_PORT=8000
